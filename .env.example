# ==============================================================================
#  FlowPilot environment
#
#  Copy to .env and fill in the three "FILL IN" blocks (PostgreSQL, Redis,
#  Freeway). Everything else has a working local default.
#  Never commit .env. Nothing in this file is exposed to the browser except
#  keys prefixed with VITE_.
# ==============================================================================

# ------------------------------------------------------------------------------
#  1. PostgreSQL                                                      [FILL IN]
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=flowpilot
DB_USERNAME=
DB_PASSWORD=
# prefer | require | verify-full | disable  (managed databases usually need "require")
DB_SSLMODE=prefer
# Optional: a full connection URL instead of the fields above.
# DB_URL=
# Both help when the database is on another machine: keep the connection open
# between requests, and send each query in a single round trip.
DB_PERSISTENT=false
DB_CONNECT_TIMEOUT=10
DB_STATEMENT_TIMEOUT=25000
DB_DISABLE_PREPARES=false

# ------------------------------------------------------------------------------
#  2. Redis (cache, sessions, queues)                                 [FILL IN]
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Leave REDIS_USERNAME empty unless your provider gives you one.
REDIS_USERNAME=
# Use the literal word null when there is no password.
REDIS_PASSWORD=null
# tcp for a plain connection, tls for managed/hosted Redis that requires TLS.
REDIS_SCHEME=tcp
# predis works everywhere (pure PHP). Use phpredis where the extension is installed (Docker image).
REDIS_CLIENT=predis
REDIS_DB=0
REDIS_CACHE_DB=1
# Optional: a full connection URL instead of the fields above.
# REDIS_URL=

# ------------------------------------------------------------------------------
#  3. AI - Freeway gateway                                            [FILL IN]
#  The AI Operations Brief stays switched off until FREEWAY_API_KEY is set.
# ------------------------------------------------------------------------------
AI_PROVIDER=freeway
FREEWAY_URL=https://freeway.pranta.dev
# The Freeway *project* API key (starts with fw_). Sent as the X-Api-Key header.
FREEWAY_API_KEY=
# free | paid | paid:low | paid:moderate | paid:premium | a specific model id
FREEWAY_MODEL=paid:premium
# Reasoning effort for models that think before answering: low | medium | high
FREEWAY_REASONING_EFFORT=low
# Seconds to wait for an answer. Freeway may try several models in turn, so keep this at 180 or more.
FREEWAY_TIMEOUT=180
# How many operations briefs one member can ask for each hour. The plan sets the daily total.
AI_BRIEF_PER_MEMBER_PER_HOUR=6

# ------------------------------------------------------------------------------
#  Application
# ------------------------------------------------------------------------------
APP_NAME=FlowPilot
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# The release being run, shown under platform administration. Set by deployment.
FLOWPILOT_VERSION=
# Who operates this service, as named in the terms and privacy policy.
LEGAL_ENTITY="Pranta Dutta"
LEGAL_CONTACT_EMAIL=prantadutta1997@gmail.com
# Country or state whose law governs the terms, e.g. "England and Wales".
LEGAL_JURISDICTION=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
#  Logging
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
#  Sessions, cache, queues
# ------------------------------------------------------------------------------
# Production: redis for all three. On a dev machine far from the Redis server,
# file sessions and cache avoid a network round trip on every request.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production (HTTPS only cookies).
# SESSION_SECURE_COOKIE=true

CACHE_STORE=redis
# CACHE_PREFIX=

QUEUE_CONNECTION=redis
# Exports and AI calls run on the "long" queue with this retry window (seconds).
# Run a second worker for it: php artisan queue:work redis-long --queue=long
LONG_QUEUE_RETRY_AFTER=1000

# ------------------------------------------------------------------------------
#  Realtime (Laravel Reverb)
#  Local defaults work as-is. In production set a public host and use https/443.
# ------------------------------------------------------------------------------
BROADCAST_CONNECTION=log

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ------------------------------------------------------------------------------
#  Mail
#  "log" writes emails to storage/logs so nothing is sent while developing.
#  Switch MAIL_MAILER to smtp (or resend / postmark / ses) and fill in the rest.
# ------------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@flowpilot.test"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
#  File storage
#  "local" keeps uploads and report exports on a private disk. Set
#  FILESYSTEM_DISK=s3 and fill in the AWS_* values to use S3 or any
#  S3-compatible store (R2, MinIO, Spaces). ATTACHMENTS_DISK and EXPORTS_DISK
#  override it for one kind of file.
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=local
# ATTACHMENTS_DISK=
# EXPORTS_DISK=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# AWS_ENDPOINT=
# AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------------------------
#  Workflow webhooks
#  Webhooks are signed and only sent to public https addresses. Set to true
#  only in local development to allow plain http test receivers.
# ------------------------------------------------------------------------------
WEBHOOKS_ALLOW_HTTP=false

# ------------------------------------------------------------------------------
#  Frontend
# ------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
#  Demo accounts (development only)
#  Password for the seeded demo users. Leave empty in production; the demo
#  seeder refuses to run without it.
# ------------------------------------------------------------------------------
DEMO_PASSWORD=
